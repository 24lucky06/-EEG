{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Probe serial board COM5",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/realtime_system/probe_serial_board.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "args": [
        "--port",
        "COM5",
        "--baud",
        "230400",
        "--seconds",
        "10"
      ]
    },
    {
      "name": "Realtime system serial COM5",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/realtime_system/desktop_monitor.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "args": [
        "--source",
        "serial",
        "--serial-port",
        "COM5",
        "--baud-rate",
        "230400",
        "--hardware-sfreq",
        "250",
        "--hardware-channel-indices",
        "1",
        "0",
        "--model",
        "${workspaceFolder}/offline_training/saved_models/sleep_stage_dual2_causal_global.joblib"
      ]
    },
    {
      "name": "Realtime system simulated",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/realtime_system/desktop_monitor.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "args": [
        "--source",
        "simulated"
      ]
    },
    {
      "name": "Extract dual2 features",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/offline_training/01_extract_features_LIGHT_FIR_vscode.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/offline_training",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "args": [
        "--subjects-file",
        "subjects_template.json",
        "--mode",
        "dual2",
        "--max-epochs",
        "None",
        "--suppress-eye-artifacts",
        "--eye-attenuation",
        "0.75",
        "--artifact-ptp-uv",
        "800"
      ]
    },
    {
      "name": "Train dual2 realtime model",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/offline_training/02_train_compare_models_vscode.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/offline_training",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "args": [
        "--mode",
        "dual2",
        "--context-mode",
        "causal"
      ]
    },
    {
      "name": "Train all32 offline model",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/offline_training/02_train_compare_models_vscode.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/offline_training",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "args": [
        "--mode",
        "all32",
        "--context-mode",
        "causal"
      ]
    },
    {
      "name": "Hardware validation demo",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/realtime_system/hardware_validation_demo.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "MPLBACKEND": "TkAgg"
      },
      "args": []
    }
  ]
}
